{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShuoleiWang/blackhole/schemas/offline-cie-xyz-frame-v1.schema.json",
  "title": "Blackhole scientific CIE XYZ frame manifest v1",
  "description": "Authenticated unnormalised CIE 1931 2-degree XYZ derived from an exact 471-bin observer-frame spectral product. This is not a display, camera, appearance, NR, or GRMHD contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cieDataset",
    "converter",
    "frame",
    "id",
    "inputSpectralProduct",
    "integrity",
    "pixelLayout",
    "schema",
    "scientificStatus",
    "summary",
    "tiles"
  ],
  "properties": {
    "cieDataset": {
      "$ref": "#/$defs/cieDataset"
    },
    "converter": {
      "$ref": "#/$defs/converterWrapper"
    },
    "frame": {
      "$ref": "#/$defs/frame"
    },
    "id": {
      "type": "string",
      "pattern": "^scientific-cie-xyz-frame-[0-9a-f]{24}$"
    },
    "inputSpectralProduct": {
      "$ref": "#/$defs/inputSpectralProduct"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "pixelLayout": {
      "$ref": "#/$defs/pixelLayout"
    },
    "schema": {
      "const": "blackhole.scientific-cie-xyz-frame/v1"
    },
    "scientificStatus": {
      "$ref": "#/$defs/scientificStatus"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tileEntry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "nonNegativeTriplet": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "cieDataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "columnSums",
        "csvMd5",
        "csvSha256",
        "datasetDoi",
        "license",
        "metadataSha256",
        "observer",
        "parsedBinary64Sha256",
        "rowCount",
        "sampleRow",
        "wavelengthGrid"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "columnSums": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "csvMd5": {
          "$ref": "#/$defs/md5"
        },
        "csvSha256": {
          "$ref": "#/$defs/sha256"
        },
        "datasetDoi": {
          "const": "10.25039/CIE.DS.xvudnb9b"
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "uri"
          ],
          "properties": {
            "id": {
              "const": "CC BY-SA 4.0"
            },
            "uri": {
              "const": "https://creativecommons.org/licenses/by-sa/4.0/"
            }
          }
        },
        "metadataSha256": {
          "$ref": "#/$defs/sha256"
        },
        "observer": {
          "const": "CIE-1931-2-degree-standard-colorimetric-observer"
        },
        "parsedBinary64Sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rowCount": {
          "const": 471
        },
        "sampleRow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "oneBasedIndex",
            "value"
          ],
          "properties": {
            "oneBasedIndex": {
              "const": 120
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "wavelengthGrid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "firstNm",
            "lastNm",
            "stepNm"
          ],
          "properties": {
            "firstNm": {
              "const": 360
            },
            "lastNm": {
              "const": 830
            },
            "stepNm": {
              "const": 1
            }
          }
        }
      }
    },
    "converterWrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor",
        "descriptorSha256"
      ],
      "properties": {
        "descriptor": {
          "$ref": "#/$defs/converterDescriptor"
        },
        "descriptorSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "converterDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "implementationId",
        "numericBackend",
        "sourceFiles"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "implementationId": {
          "const": "blackhole.spectral-to-cie-xyz/v1"
        },
        "numericBackend": {
          "type": "object",
          "minProperties": 1,
          "required": [
            "implementationId"
          ],
          "properties": {
            "implementationId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sourceFiles": {
          "type": "array",
          "minItems": 19,
          "maxItems": 19,
          "items": {
            "$ref": "#/$defs/sourceFile"
          }
        }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "moduleUri",
        "sha256"
      ],
      "properties": {
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "moduleUri": {
          "enum": [
            "assets/science/cie/CIE_xyz_1931_2deg.csv",
            "assets/science/cie/CIE_xyz_1931_2deg.csv_metadata.json",
            "offline/__init__.py",
            "offline/adaptive_frame.py",
            "offline/cie_color.py",
            "offline/cie_product.py",
            "offline/geodesic.py",
            "offline/job.py",
            "offline/kerr.py",
            "offline/radiative_transfer.py",
            "offline/spacetime.py",
            "offline/spectral_frame.py",
            "offline/spectral_product.py",
            "schemas/offline-cie-xyz-frame-v1.schema.json",
            "schemas/offline-scientific-spectral-frame-v1.schema.json",
            "scripts/convert_offline_spectral_to_cie_xyz.py",
            "scripts/verify_nr_contract.py",
            "scripts/verify_offline_cie_xyz.py",
            "scripts/verify_offline_spectral_frame.py"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heightPixels",
        "imageOrigin",
        "pixelOrder",
        "projection",
        "sampleIndices",
        "screenBounds",
        "widthPixels"
      ],
      "properties": {
        "heightPixels": {
          "type": "integer",
          "minimum": 1
        },
        "imageOrigin": {
          "const": "lower-left"
        },
        "pixelOrder": {
          "const": "sample-then-row-major-y-then-x"
        },
        "projection": {
          "const": "pinhole-screen-z-equals-one"
        },
        "sampleIndices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "screenBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "xMax",
            "xMin",
            "yMax",
            "yMin"
          ],
          "properties": {
            "xMax": {
              "type": "number"
            },
            "xMin": {
              "type": "number"
            },
            "yMax": {
              "type": "number"
            },
            "yMin": {
              "type": "number"
            }
          }
        },
        "widthPixels": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inputSpectralProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifestSha256",
        "physicsVerified",
        "productSha256",
        "provenanceScope",
        "recordCount",
        "schema",
        "structuralStatus",
        "tileCount"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^scientific-spectral-frame-[0-9a-f]{24}$"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "physicsVerified": {
          "const": false
        },
        "productSha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenanceScope": {
          "type": "string",
          "minLength": 1
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1
        },
        "schema": {
          "const": "blackhole.scientific-spectral-frame/v1"
        },
        "structuralStatus": {
          "const": "scientific-spectral-frame-structural-contract-conformant"
        },
        "tileCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationSha256",
        "manifestSidecar",
        "productSha256"
      ],
      "properties": {
        "configurationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifestSidecar": {
          "const": "manifest.sha256"
        },
        "productSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pixelLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convergenceMaskOffsetBytes",
        "endianness",
        "estimatedAbsoluteErrorXyzOffsetBytes",
        "errorSemantics",
        "floatEncoding",
        "id",
        "inputRecordSha256OffsetBytes",
        "meanCieXyzOffsetBytes",
        "recordBytes",
        "sourceMaskOffsetBytes"
      ],
      "properties": {
        "convergenceMaskOffsetBytes": {
          "const": 84
        },
        "endianness": {
          "const": "little"
        },
        "estimatedAbsoluteErrorXyzOffsetBytes": {
          "const": 24
        },
        "errorSemantics": {
          "const": "linear-propagated-finite-stencil-estimate-not-rigorous-bound"
        },
        "floatEncoding": {
          "const": "IEEE-754-binary64"
        },
        "id": {
          "const": "blackhole.scientific-cie-xyz-pixel/le-f64-v1"
        },
        "inputRecordSha256OffsetBytes": {
          "const": 48
        },
        "meanCieXyzOffsetBytes": {
          "const": 0
        },
        "recordBytes": {
          "const": 88
        },
        "sourceMaskOffsetBytes": {
          "const": 80
        }
      }
    },
    "scientificStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmValidation",
        "classification",
        "displayTransferApplied",
        "errorSemantics",
        "isAbsoluteHumanAppearanceModel",
        "isCameraSensorModel",
        "isGeneralRelativisticMagnetohydrodynamics",
        "isInputPhysicsRecomputed",
        "isIndependentColourAlgorithmOracle",
        "isNumericalRelativitySolver",
        "linearSrgbStored",
        "primaryQuantity",
        "primaryUnits",
        "prohibitedClaim",
        "toneMappingApplied"
      ],
      "properties": {
        "algorithmValidation": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "displayTransferApplied": {
          "const": false
        },
        "errorSemantics": {
          "type": "string",
          "minLength": 1
        },
        "isAbsoluteHumanAppearanceModel": {
          "const": false
        },
        "isCameraSensorModel": {
          "const": false
        },
        "isGeneralRelativisticMagnetohydrodynamics": {
          "const": false
        },
        "isInputPhysicsRecomputed": {
          "const": false
        },
        "isIndependentColourAlgorithmOracle": {
          "const": false
        },
        "isNumericalRelativitySolver": {
          "const": false
        },
        "linearSrgbStored": {
          "const": false
        },
        "primaryQuantity": {
          "type": "string",
          "minLength": 1
        },
        "primaryUnits": {
          "type": "string",
          "minLength": 1
        },
        "prohibitedClaim": {
          "type": "string",
          "minLength": 1
        },
        "toneMappingApplied": {
          "const": false
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convergenceMaskIntersection",
        "estimatedAbsoluteErrorCieXyzOverFrame",
        "inputRecordSha256Chain",
        "integratedCieXyzOverFrame",
        "maximumMeanCieXyz",
        "maximumMeanEstimatedAbsoluteErrorXyz",
        "recordCount",
        "requiredConvergenceMask",
        "sourceMaskUnion"
      ],
      "properties": {
        "convergenceMaskIntersection": {
          "type": "integer",
          "minimum": 0
        },
        "estimatedAbsoluteErrorCieXyzOverFrame": {
          "$ref": "#/$defs/nonNegativeTriplet"
        },
        "inputRecordSha256Chain": {
          "$ref": "#/$defs/sha256"
        },
        "integratedCieXyzOverFrame": {
          "$ref": "#/$defs/nonNegativeTriplet"
        },
        "maximumMeanCieXyz": {
          "$ref": "#/$defs/nonNegativeTriplet"
        },
        "maximumMeanEstimatedAbsoluteErrorXyz": {
          "$ref": "#/$defs/nonNegativeTriplet"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1
        },
        "requiredConvergenceMask": {
          "const": 255
        },
        "sourceMaskUnion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "sha256",
        "uri"
      ],
      "properties": {
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "uri": {
          "type": "string",
          "pattern": "^tiles/t[0-9]{6}-y[0-9]{6}-x[0-9]{6}-w[0-9]{6}-h[0-9]{6}\\.(spx|cxyz)$"
        }
      }
    },
    "tileCoordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "width",
        "x",
        "y"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputPayload",
        "outputPayload",
        "recordCount",
        "recordOrder",
        "sampleIndex",
        "tile"
      ],
      "properties": {
        "inputPayload": {
          "$ref": "#/$defs/artifact"
        },
        "outputPayload": {
          "$ref": "#/$defs/artifact"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1
        },
        "recordOrder": {
          "const": "row-major-local-y-then-x"
        },
        "sampleIndex": {
          "type": "integer",
          "minimum": 0
        },
        "tile": {
          "$ref": "#/$defs/tileCoordinates"
        }
      }
    }
  }
}
