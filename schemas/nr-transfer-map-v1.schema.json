              "$ref": "#/$defs/positiveNumber"
            }
          }
        },
        "referenceObserver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "definition",
            "sourceArtifactRole"
          ],
          "properties": {
            "kind": {
              "enum": [
                "eulerian-normal",
                "asymptotic-inertial",
                "synthetic-inertial"
              ]
            },
            "definition": {
              "type": "string",
              "minLength": 1
            },
            "sourceArtifactRole": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "frequencyShiftConvention": {
          "const": "g=(u_observer·k_observer)/(u_boundary·k_boundary)"
        },
        "storedEscapeDirection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame",
            "normalization",
            "continuationBeyondBoundary"
