        "sampleIndex": {
          "type": "integer",
          "minimum": 0
        },
        "protocolTimeM": {
          "$ref": "#/$defs/finiteNumber"
        },
        "eventNr": {
          "$ref": "#/$defs/vector4"
        },
        "metricCovariantNr": {
          "$ref": "#/$defs/matrix4"
        },
        "metricContravariantNr": {
          "$ref": "#/$defs/matrix4"
        },
        "fourVelocityContravariantNr": {
          "$ref": "#/$defs/vector4"
        },
        "properTimeM": {
          "$ref": "#/$defs/finiteNumber"
        },
        "tetradContravariantNr": {
          "$ref": "#/$defs/tetrad4"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameType",
        "motion",
        "matrixConvention",
        "basisOrder",
        "cameraToWorld",
        "worldToCamera",
        "physicalRelation"
      ],
      "properties": {
        "frameType": {
          "const": "affine-visualization-frame"
        },
        "motion": {
          "const": "fixed"
        },
        "matrixConvention": {
          "const": "row-major spatial affine 4x4 matrices multiplying [x,y,z,1] column vectors; not spacetime coordinate transforms"
        },
        "basisOrder": {
          "const": [
            "right",
            "up",
            "forward"
          ]
        },
        "cameraToWorld": {
          "$ref": "#/$defs/matrix4"
        },
        "worldToCamera": {
          "$ref": "#/$defs/matrix4"
        },
        "physicalRelation": {
          "const": "The affine frame is for deterministic playback coordinates; physical ray initialization uses the observer tetrad."
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "widthPixels",
        "heightPixels",
        "verticalFieldOfViewRad",
        "imageOrigin",
        "pixelSampleLocation",
        "aspectConvention",
        "screenXFormula",
        "screenYFormula",
        "rayTimeOrientation",
        "localRayConvention"
      ],
      "properties": {
        "model": {
          "const": "rectilinear-pinhole"
        },
        "widthPixels": {
          "type": "integer",
          "minimum": 1
        },
        "heightPixels": {
          "type": "integer",
          "minimum": 1
        },
        "verticalFieldOfViewRad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 3.141592653589793
        },
        "imageOrigin": {
          "const": "top-left"
        },
        "pixelSampleLocation": {
          "const": "center"
        },
        "aspectConvention": {
          "const": "aspect=widthPixels/heightPixels"
        },
        "screenXFormula": {
          "const": "screenX=((x+0.5)/widthPixels*2-1)*aspect*tan(verticalFieldOfViewRad/2)"
        },
        "screenYFormula": {
          "const": "screenY=(1-(y+0.5)/heightPixels*2)*tan(verticalFieldOfViewRad/2)"
        },
        "rayTimeOrientation": {
          "const": "past-directed"
        },
        "localRayConvention": {
          "const": "k^(a)=(-1,normalize(screenX,screenY,1)) in the time/right/up/forward tetrad"
        }
      }
    },
    "interpolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "continuous",
        "escapeDirection",
        "categorical",
        "invalidRecords"
      ],
      "properties": {
        "time": {
          "enum": [
            "none",
            "validity-strict-linear"
          ]
        },
        "continuous": {
          "enum": [
            "validity-strict-linear",
            "none-nearest-texel-center"
          ]
        },
        "escapeDirection": {
          "enum": [
            "validity-strict-linear-then-normalize",
            "nearest-no-blend"
          ]
        },
        "categorical": {
          "const": "nearest-no-blend"
        },
        "invalidRecords": {
          "const": "never-sample-sky"
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationTimesM",
