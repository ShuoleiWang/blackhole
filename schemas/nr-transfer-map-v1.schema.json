          "properties": {
            "frame": {
              "const": "ICRS"
            },
            "normalization": {
              "const": "unit Euclidean spatial vector"
            },
            "continuationBeyondBoundary": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
