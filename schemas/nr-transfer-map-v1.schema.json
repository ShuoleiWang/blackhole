            {
              "name": "frequencyShiftG",
              "offsetBytes": 12,
              "componentType": "float32",
              "components": 1
            },
            {
              "name": "coordinateLookbackTimeM",
              "offsetBytes": 16,
              "componentType": "float32",
              "components": 1
