    "escapeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "referenceObserver",
        "frequencyShiftConvention",
        "storedEscapeDirection"
      ],
      "properties": {
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "required": [
